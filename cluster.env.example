# Copy to cluster.env and adapt. Sourced by every script in scripts/.
HEAD_SSH=user@head-node
WORKER_SSH=user@worker-node

# Addresses of the direct link. Run `cluster.sh check` to confirm that the kernel routes
# WORKER_LINK_IP through the interface holding HEAD_LINK_IP, otherwise RDMA stays off.
HEAD_LINK_IP=192.0.2.16
WORKER_LINK_IP=192.0.2.17
RPC_PORT=50052

# Leave empty if the nodes reach the internet directly.
PROXY=

REMOTE_ROOT=/home/user/minichonk
CUDA_HOME=/usr/local/cuda
LLAMA_REPO=https://github.com/ggml-org/llama.cpp.git
LLAMA_COMMIT=fb5997274

HF_REPO=unsloth/Mistral-Large-4-1T-A52B-GGUF
SOURCE_QUANT=UD-IQ1_S

# Configuration started by `cluster.sh up`.
FINAL_MASK=aimer112
FINAL_MODEL=$REMOTE_ROOT/models/IQ1_S-$FINAL_MASK
FINAL_DRAFT=$REMOTE_ROOT/models/dspark/dspark-Q8_0.gguf
FINAL_CTX=32768
